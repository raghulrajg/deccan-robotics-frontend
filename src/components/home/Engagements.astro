---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { engagements } from '@/data/content';
import { href } from '@/lib/url';

interface Props {
  /** On /how-we-work the cards carry anchor ids and the header changes. */
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<section class="section theme-light section--alt" aria-labelledby="engage-title">
  <div class="container">
    <SectionHeader
      id="engage-title"
      index={detailed ? undefined : '02'}
      eyebrow="Ways to work together"
      title="Start small. Prove it.<br /> <em>Then build it.</em>"
      lead="Every engagement is scoped around a clear question and ends with something you can hold, test or decide on."
      align="split"
    />

    <ol role="list" class="eng" data-reveal-stagger="100">
      {
        engagements.map((e, i) => (
          <li class="eng__item card" id={detailed ? e.id : undefined} data-reveal>
            <div class="eng__top">
              <span class="eng__step mono">{e.step}</span>
              <span class="icon-tile">
                <Icon name={e.icon} />
              </span>
            </div>
            <h3 class="h3 eng__name">{e.name}</h3>
            <p class="eng__tagline">{e.tagline}</p>
            <dl class="eng__meta">
              <div>
                <dt class="mono">Typical duration</dt>
                <dd>{e.duration}</dd>
              </div>
              <div>
                <dt class="mono">Best for</dt>
                <dd>{e.bestFor}</dd>
              </div>
            </dl>
            <div class="eng__deliv">
              <p class="mono eng__label">You get</p>
              <ul class="check-list">
                {e.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
            {i < engagements.length - 1 && (
              <span class="eng__arrow" aria-hidden="true">
                <Icon name="arrow-right" strokeWidth={2} />
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <div class="eng__note" data-reveal>
      <Icon name="handshake" class="icon" />
      <p>
        <strong>Need ongoing engineering capacity?</strong> We also work on retainers, embedded with your team
        or owning a subsystem end to end.
      </p>
      {
        !detailed && (
          <a class="text-link" href={href('/how-we-work/')}>
            How we work
            <Icon name="arrow-right" strokeWidth={2} />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .eng {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
    padding: 0;
    counter-reset: eng;
  }

  .eng__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .eng__item:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .eng__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xs);
  }

  .eng__step {
    font-size: 2.6rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg-subtle);
  }

  .eng__tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
  }

  .eng__meta {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-s);
    border-block: 1px dashed var(--border-strong);
  }

  .eng__meta div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-xs);
    align-items: baseline;
  }

  .eng__meta dt,
  .eng__label {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .eng__meta dd {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .eng__label {
    margin-bottom: var(--space-xs);
  }

  .eng__arrow {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: calc(-1 * var(--space-l) / 2 - 18px);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--laterite-500);
    color: var(--basalt-950);
    box-shadow: 0 0 0 6px var(--bg-alt);
  }

  .eng__arrow :global(svg) {
    width: 18px;
    height: 18px;
  }

  .eng__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-xl);
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .eng__note > :global(.icon) {
    width: 28px;
    height: 28px;
    color: var(--accent-text);
  }

  .eng__note p {
    flex: 1 1 320px;
    color: var(--fg-muted);
  }

  .eng__note strong {
    color: var(--fg);
  }

  @media (max-width: 1080px) {
    .eng {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .eng__arrow {
      top: auto;
      right: auto;
      bottom: calc(-1 * var(--space-xl) / 2 - 18px);
      left: 50%;
      transform: translateX(-50%) rotate(90deg);
    }
  }

  @media (max-width: 480px) {
    .eng__item {
      padding: var(--space-m);
    }

    .eng__meta div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
