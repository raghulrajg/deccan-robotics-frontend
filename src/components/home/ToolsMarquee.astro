---
import { tools } from '@/data/content';
---

<section class="marquee theme-dark" aria-label="Platforms and tools we work with">
  <div class="container marquee__inner">
    <p class="marquee__label mono">Platforms &amp; tools we build with</p>
    <div class="marquee__viewport">
      <ul role="list" class="marquee__track">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
      <ul role="list" class="marquee__track" aria-hidden="true">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    border-block: 1px solid var(--border);
    background: var(--basalt-950);
  }

  .marquee__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding-block: 1.15rem;
  }

  .marquee__label {
    flex: none;
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .marquee__viewport {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    flex: none;
    gap: 0;
    padding: 0;
    animation: marquee 60s linear infinite;
  }

  .marquee__viewport:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__track li {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .marquee__track li::after {
    content: '';
    width: 5px;
    height: 5px;
    margin-inline: 1.4rem;
    background: var(--laterite-500);
    transform: rotate(45deg);
    opacity: 0.7;
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 720px) {
    .marquee__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee__track {
      flex-wrap: wrap;
      row-gap: 0.4rem;
      flex: 1;
    }

    .marquee__track[aria-hidden] {
      display: none;
    }
  }
</style>
