---
/**
 * Robotics illustration: an AMR following an A*-planned path through a
 * warehouse occupancy grid. Explored cells are computed at build time.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = 'Mobile robot following a planned path through a warehouse map' } =
  Astro.props;

const racks = [
  { x: 100, y: 40, w: 40, h: 140, name: 'A' },
  { x: 200, y: 120, w: 40, h: 160, name: 'B' },
  { x: 300, y: 40, w: 40, h: 140, name: 'C' },
];
const route: [number, number][] = [
  [50, 270],
  [170, 270],
  [170, 90],
  [270, 90],
  [270, 220],
  [420, 220],
  [420, 60],
];
const pathD =
  'M50 270H156Q170 270 170 256V104Q170 90 184 90H256Q270 90 270 104V206Q270 220 284 220H406Q420 220 420 206V60';

function distToSeg(px: number, py: number, [ax, ay]: number[], [bx, by]: number[]) {
  const dx = bx - ax;
  const dy = by - ay;
  const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)));
  return Math.hypot(px - (ax + t * dx), py - (ay + t * dy));
}
const explored: { x: number; y: number; o: number }[] = [];
const buckets = new Map<string, string[]>();
for (let x = 20; x < 460; x += 20) {
  for (let y = 20; y < 300; y += 20) {
    const cx = x + 10;
    const cy = y + 10;
    if (racks.some((r) => cx > r.x - 4 && cx < r.x + r.w + 4 && cy > r.y - 4 && cy < r.y + r.h + 4)) continue;
    let d = Infinity;
    for (let i = 0; i < route.length - 1; i++) d = Math.min(d, distToSeg(cx, cy, route[i], route[i + 1]));
    if (d < 34) {
      const o = 0.11 * (1 - d / 36) + 0.025;
      explored.push({ x, y, o });
      const key = (Math.round(o * 50) / 50).toFixed(2); // a few opacity levels
      if (!buckets.has(key)) buckets.set(key, []);
      buckets.get(key)!.push(`M${x + 1} ${y + 1}h18v18h-18z`);
    }
  }
}
let length = 0;
for (let i = 0; i < route.length - 1; i++)
  length += Math.hypot(route[i + 1][0] - route[i][0], route[i + 1][1] - route[i][1]);
const meters = ((length * 4) / 100).toFixed(1); // 1 unit = 4 cm
const uid = `amr-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['ill', 'amr', className]}
  viewBox="0 0 480 320"
  role="img"
  aria-label={label}
>
  <defs>
    <pattern id={`${uid}-grid`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="var(--ill-grid)" stroke-width="1"></path>
    </pattern>
    <pattern id={`${uid}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V6" stroke="var(--ill-line)" stroke-width="1.2"></path>
    </pattern>
  </defs>

  <rect x="10" y="10" width="460" height="300" rx="6" fill="var(--ill-bg)" stroke="var(--ill-line)"></rect>
  <rect x="10" y="10" width="460" height="300" rx="6" fill={`url(#${uid}-grid)`}></rect>

  <!-- explored set -->
  <g>
    {[...buckets].map(([o, cells]) => <path d={cells.join('')} fill="var(--laterite-500)" opacity={o} />)}
  </g>

  <!-- racks -->
  {
    racks.map((r) => (
      <g>
        <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={`url(#${uid}-hatch)`} stroke="var(--ill-strong)" />
        {Array.from({ length: Math.floor(r.h / 40) - 1 }, (_, i) => (
          <path d={`M${r.x} ${r.y + 40 * (i + 1)}h${r.w}`} stroke="var(--ill-strong)" />
        ))}
        <rect x={r.x + r.w / 2 - 9} y={r.y + r.h / 2 - 8} width="18" height="16" rx="2" fill="var(--ill-bg)" />
        <text x={r.x + r.w / 2} y={r.y + r.h / 2 + 4} text-anchor="middle" class="ill__label ill__label--strong">
          {r.name}
        </text>
      </g>
    ))
  }

  <!-- planned path -->
  <path d={pathD} class="amr__path" pathLength="100"></path>

  <!-- start / goal -->
  <g transform="translate(50 270)">
    <circle r="6" fill="none" stroke="var(--ill-strong)" stroke-width="1.5"></circle>
    <text x="0" y="-14" text-anchor="middle" class="ill__label">START</text>
  </g>
  <g transform="translate(420 60)" class="amr__goal">
    <circle r="12" fill="none" stroke="var(--laterite-500)" stroke-width="1.5" class="amr__pulse"></circle>
    <circle r="5" fill="var(--laterite-500)"></circle>
    <text x="0" y="-20" text-anchor="middle" class="ill__label ill__label--accent">GOAL</text>
  </g>

  <!-- robot -->
  <g class="amr__robot">
    <g>
      <path d="M0 0L64 -18A66 66 0 0 1 64 18Z" class="amr__scan">
        <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="2.2s" repeatCount="indefinite"></animateTransform>
      </path>
      <rect x="-13" y="-11" width="26" height="22" rx="5" fill="var(--laterite-500)" stroke="#a63a0b"></rect>
      <rect x="-10" y="-14" width="10" height="4" rx="1" fill="var(--ill-strong)"></rect>
      <rect x="-10" y="10" width="10" height="4" rx="1" fill="var(--ill-strong)"></rect>
      <circle cx="5" cy="0" r="4.5" fill="#1b2026" stroke="#fff" stroke-opacity="0.5"></circle>
      <path d="M-7 -4l4 4-4 4" fill="none" stroke="#1b2026" stroke-width="1.8" stroke-linecap="round"></path>
    </g>
    <animateMotion dur="11s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;1" keyTimes="0;0.86;1" calcMode="linear" path={pathD}></animateMotion>
    <animate attributeName="opacity" values="1;1;0;0;1" keyTimes="0;0.9;0.95;0.99;1" dur="11s" repeatCount="indefinite"></animate>
  </g>

  <!-- readout -->
  <text x="24" y="30" class="ill__label">A* · {meters} m · {explored.length} nodes</text>
</svg>

<style>
  .amr__path {
    fill: none;
    stroke: var(--laterite-500);
    stroke-width: 2;
    stroke-dasharray: 1.2 1.4;
    stroke-linecap: round;
    animation: amr-march 6s linear infinite;
  }

  .amr__scan {
    fill: var(--laterite-500);
    opacity: 0.16;
  }

  .amr__pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: amr-pulse 2s var(--ease-out) infinite;
  }

  @keyframes amr-march {
    to {
      stroke-dashoffset: -26;
    }
  }

  @keyframes amr-pulse {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
</style>
